# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/kuldeep_portfolio

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min32chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://kuldeepsen.com

# Initial Admin Credentials (used during database seed)
ADMIN_NAME="Kuldeep Sen"
ADMIN_EMAIL=admin@kuldeepsen.com
ADMIN_PASSWORD=SuperSecureAdminPassword123!

# Email / SMTP Configuration (Optional - graceful degradation if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Kuldeep Sen Portfolio" <no-reply@kuldeepsen.com>
NOTIFICATION_RECEIVER_EMAIL=kuldeep@kuldeepsen.com

# Cloudinary Media Uploads (Optional - graceful degradation if not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_MAX=5
